# Use pre-built Flutter image for faster builds
FROM ghcr.io/cirruslabs/flutter:3.16.9 AS flutter

# Set working directory
WORKDIR /app

# Copy pubspec files first for better layer caching
COPY pubspec.yaml pubspec.lock ./

# Get dependencies (this layer will be cached if pubspec doesn't change)
RUN flutter pub get

# Copy source code
COPY . .

# Build web app with optimizations
RUN flutter build web --release --web-renderer canvaskit

# Runtime stage - use lightweight nginx
FROM nginx:alpine

# Copy built web app
COPY --from=flutter /app/build/web /usr/share/nginx/html

# Copy custom nginx config for SPA routing
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy entrypoint script
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Expose port
EXPOSE 3000

# Use entrypoint script to inject environment variables
ENTRYPOINT ["/entrypoint.sh"]

